<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <UseCurrentRuntimeIdentifier>true</UseCurrentRuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <!-- Allow the test project to drive internal reconciliation hooks directly. -->
    <InternalsVisibleTo Include="Circles.Cache.Service.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.Extensions.Diagnostics.HealthChecks is deliberately absent, even
         though Program.cs calls AddHealthChecks and MapHealthChecks. This is an
         Sdk="Microsoft.NET.Sdk.Web" project, so the Microsoft.AspNetCore.App shared
         framework already supplies both. The .NET 10 SDK prunes the package reference
         (NU1510) and the assembly never reaches the publish output, so a PackageVersion
         pin for it is silently discarded. Measured rather than assumed: publishing this
         project produces no entry for it in Circles.Cache.Service.deps.json. Same
         reasoning as the removal recorded in src/Index/Circles.Index/Circles.Index.csproj. -->
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" />

    <!-- PostgreSQL -->
    <PackageReference Include="Npgsql" />

    <!-- Dependency Injection -->
    <PackageReference Include="Autofac" />
    <PackageReference Include="Autofac.Extensions.DependencyInjection" />

    <!-- Monitoring -->
    <PackageReference Include="prometheus-net" />
    <PackageReference Include="prometheus-net.AspNetCore" />

    <!-- OpenTelemetry Tracing -->
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" />
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AspNetCore" />
    <PackageReference Include="Npgsql.OpenTelemetry" />

    <!-- Numerics for Circles calculations -->
    <PackageReference Include="Nethermind.Numerics.Int256" />

    <!-- OpenAPI documentation.
         Microsoft.OpenApi is listed explicitly even though nothing here uses it
         directly: Microsoft.AspNetCore.OpenApi pulls it transitively at a
         version carrying GHSA-v5pm-xwqc-g5wc (high), and central package
         management does not reach a transitive dependency. Naming it here is
         what lets Directory.Packages.props set the version, and it matches what
         Circles.Pathfinder.Host already does. Drop it once
         Microsoft.AspNetCore.OpenApi itself depends on a patched version. -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <!-- Reference to Common (for RollbackCache and shared types) -->
    <ProjectReference Include="..\..\Common\Circles.Common\Circles.Common.csproj">
      <!-- Exclude Nethermind reference assemblies - cache service doesn't need them -->
      <ExcludeAssets>all</ExcludeAssets>
      <IncludeAssets>compile;build</IncludeAssets>
    </ProjectReference>

    <!-- Reference to Query (for database access patterns) -->
    <ProjectReference Include="..\..\Index\Circles.Index.Query\Circles.Index.Query.csproj">
      <ExcludeAssets>all</ExcludeAssets>
      <IncludeAssets>compile;build</IncludeAssets>
    </ProjectReference>

    <!-- Reference to DatabaseSchemaProvider (for DB schema) -->
    <ProjectReference
      Include="..\..\Index\Circles.Index.DatabaseSchemaProvider\Circles.Index.DatabaseSchemaProvider.csproj">
      <ExcludeAssets>all</ExcludeAssets>
      <IncludeAssets>compile;build</IncludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>